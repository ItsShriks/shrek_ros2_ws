  <version>0.1.0</version>
  <description>Essential robot description and configuration files for Shrek robot</description>
  <maintainer email="shrikar@todo.todo">Shrikar</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>urdf</exec_depend>
