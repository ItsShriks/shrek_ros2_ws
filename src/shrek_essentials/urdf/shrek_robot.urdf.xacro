<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="shrek_robot">

  <!-- Properties -->
  <xacro:property name="chassis_length" value="0.6"/>
  <xacro:property name="chassis_width" value="0.52"/>  <!-- Hexagon width -->
  <xacro:property name="chassis_height" value="0.2"/>
  <xacro:property name="chassis_mass" value="20.0"/>
  
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_mass" value="1.0"/>
  <xacro:property name="wheel_offset_x" value="0.2"/>
  <xacro:property name="wheel_offset_y" value="0.3"/>
  <xacro:property name="wheel_offset_z" value="0.0"/>
  
  <xacro:property name="lidar_size" value="0.05"/>
  <xacro:property name="lidar_mass" value="0.3"/>

  <!-- Colors -->
  <material name="green">
    <color rgba="0.0 0.8 0.2 1.0"/>
  </material>
  
  <material name="purple">
    <color rgba="0.6 0.2 0.8 1.0"/>
  </material>
  
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- Base Link (Hexagonal Chassis) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${chassis_height}" radius="${chassis_width/2}"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${chassis_height}" radius="${chassis_width/2}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${(1/12) * chassis_mass * (3 * (chassis_width/2) * (chassis_width/2) + chassis_height * chassis_height)}" 
               ixy="0.0" ixz="0.0"
               iyy="${(1/12) * chassis_mass * (3 * (chassis_width/2) * (chassis_width/2) + chassis_height * chassis_height)}" 
               iyz="0.0"
               izz="${(1/2) * chassis_mass * (chassis_width/2) * (chassis_width/2)}"/>
    </inertial>
  </link>

  <!-- Base Footprint -->
  <link name="base_footprint"/>
  
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Wheel Macro -->
  <xacro:macro name="wheel" params="prefix reflect_x reflect_y">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
        <material name="purple"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${(1/12) * wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width)}" 
                 ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width)}" 
                 iyz="0.0"
                 izz="${(1/2) * wheel_mass * wheel_radius * wheel_radius}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${reflect_x * wheel_offset_x} ${reflect_y * wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Create 4 wheels -->
  <xacro:wheel prefix="front_left" reflect_x="1" reflect_y="1"/>
  <xacro:wheel prefix="front_right" reflect_x="1" reflect_y="-1"/>
  <xacro:wheel prefix="rear_left" reflect_x="-1" reflect_y="1"/>
  <xacro:wheel prefix="rear_right" reflect_x="-1" reflect_y="-1"/>

  <!-- LiDAR Sensor -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${lidar_size}" radius="${lidar_size}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${lidar_size}" radius="${lidar_size}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${lidar_mass}"/>
      <inertia ixx="${(1/12) * lidar_mass * (3 * lidar_size * lidar_size + lidar_size * lidar_size)}" 
               ixy="0.0" ixz="0.0"
               iyy="${(1/12) * lidar_mass * (3 * lidar_size * lidar_size + lidar_size * lidar_size)}" 
               iyz="0.0"
               izz="${(1/2) * lidar_mass * lidar_size * lidar_size}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_height/2 + lidar_size/2}" rpy="0 0 0"/>
  </joint>

</robot>
